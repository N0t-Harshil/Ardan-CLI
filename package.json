{
  "name": "ardan",
  "version": "0.6.0",
  "description": "Ardan - a fast, lightweight, zero-dependency coding-agent CLI for Ollama (local), Anthropic, OpenAI, Gemini, Groq, Mistral, OpenRouter, DeepSeek and any OpenAI-compatible endpoint",
  "type": "module",
  "bin": {
    "ardan": "bin/ardan.js"
  },
  "files": [
    "bin/",
    "src/"
  ],
  "scripts": {
    "start": "node bin/ardan.js",
    "test": "node --test \"tests/*.test.ts\"",
    "typecheck": "tsc -p .",
    "check": "npm run typecheck && npm test"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "keywords": [
    "cli",
    "agent",
    "coding-agent",
    "openai",
    "anthropic",
    "gemini",
    "ollama",
    "groq",
    "openclaude",
    "claude-code"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "~5.6.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/N0t-Harshil/Ardan-CLI.git"
  }
}
